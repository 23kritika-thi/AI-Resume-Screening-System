# Example Database Configuration Template
# Copy this to src/main/resources/database.properties or run with environment variables

db.host=localhost
db.port=3306
db.name=resume_screening_db
db.user=root
db.password=YOUR_MYSQL_PASSWORD_HERE

db.useSSL=false
db.allowPublicKeyRetrieval=true
db.serverTimezone=UTC
db.characterEncoding=UTF-8
